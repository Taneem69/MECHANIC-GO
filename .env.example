# Copy to .env.local for local work. On Vercel set these under Settings -> Environment Variables.
# Every VITE_* value is bundled into public JavaScript. NEVER put secrets here.

# Your public site URL (custom domain once you have one). Used for canonical, sitemap, OG tags.
VITE_SITE_URL=https://your-domain.com

# Optional. Nothing loads if left empty.
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
VITE_VITALS_ENDPOINT=
